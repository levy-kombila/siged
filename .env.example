# Copier en .env puis adapter. NE JAMAIS versionner le fichier .env.
SIGED_ENVIRONMENT=prod
SIGED_SECRET_KEY=remplacer-par-une-longue-chaine-aleatoire   # python -c "import secrets;print(secrets.token_urlsafe(48))"
# Clé AES-256 du chiffrement au repos (32 octets en base64) : python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# A SAUVEGARDER HORS DU SERVEUR : sans elle, les fichiers sont irrécupérables.
SIGED_STORAGE_ENCRYPTION_KEY=

POSTGRES_DB=siged
POSTGRES_USER=siged
POSTGRES_PASSWORD=changer-ce-mot-de-passe
SIGED_DATABASE_URL=postgresql+psycopg://siged:changer-ce-mot-de-passe@postgres:5432/siged

SIGED_STORAGE_BACKEND=s3
SIGED_S3_ENDPOINT_URL=http://minio:9000
SIGED_S3_ACCESS_KEY=siged
SIGED_S3_SECRET_KEY=changer-ce-secret-minio
SIGED_S3_BUCKET=siged-documents
MINIO_ROOT_USER=siged
MINIO_ROOT_PASSWORD=changer-ce-secret-minio

SIGED_BOOTSTRAP_ADMIN_PASSWORD=Changer@MoiVite2026
SIGED_RETENTION_AUTO_EXECUTE=false
SIGED_OCR_LANGUAGES=fra+eng

# Notifications (optionnel)
