{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "cdg1"
  ],
  "functions": {
    "index.py": {
      "maxDuration": 60,
      "excludeFiles": "{docs/**,deploy/**,backend/tests/**,backend/data/**,**/*.db,.github/**}"
    }
  },
  "crons": [
    {
      "path": "/api/cron/daily",
      "schedule": "0 2 * * *"
    }
  ]
}
